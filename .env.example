# ── Meta Marketing API ──────────────────────────────────────────────
# Free: Meta charges nothing for API calls. Two kinds of token work here:
#   • Long-lived user token  — ~60 days, from developers.facebook.com/tools/explorer
#                              then "Extend Access Token" in the Token Debugger
#   • System User token      — never expires, from Business Settings → Users →
#                              System users (requires portfolio Admin rights)
# Either way the scope needed is: ads_read
META_ACCESS_TOKEN=

# Optional. Defaults to v26.0 (current latest).
# META_API_VERSION=v26.0

# ── Server ──────────────────────────────────────────────────────────
PORT=3500

# ── Slack (optional) ────────────────────────────────────────────────
# Budget alerts + daily/weekly summaries + token expiry warnings.
SLACK_WEBHOOK_URL=

# ── Alerting ────────────────────────────────────────────────────────
ALERT_WARN_THRESHOLD=80      # yellow at 80% of budget
ALERT_DANGER_THRESHOLD=95    # red at 95% of budget
REFRESH_INTERVAL_MINUTES=60  # how often to pull from Meta
TOKEN_WARN_DAYS=7            # Slack warning this many days before token expiry


# ── Dashboard authentication ────────────────────────────────────────
# Required. Without all three the dashboard is served to anyone who can
# reach the port, and the server warns loudly on boot.
#
# Generate the hash and secret (never commit the plaintext password):
#   node -e "const c=require('crypto');const s=c.randomBytes(16);
#   console.log('AUTH_PASSWORD_HASH=scrypt\$16384\$8\$1\$'+s.toString('base64')+'\$'+
#   c.scryptSync(process.argv[1],s,64,{N:16384,r:8,p:1}).toString('base64'));
#   console.log('SESSION_SECRET='+c.randomBytes(48).toString('base64'))" 'YOUR-PASSWORD'
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
SESSION_SECRET=

# How long a login lasts before it has to be repeated.
SESSION_HOURS=12

# Force the Secure cookie flag. Auto-detected from X-Forwarded-Proto when
# running behind Nginx with SSL, so normally you can leave this alone.
# COOKIE_SECURE=true
