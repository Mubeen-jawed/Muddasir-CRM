# dependencies
/node_modules

# env files
.env*
!.env.example

# PM2 runtime logs
/logs
*.log

# editor/OS noise
.DS_Store

# stale local backups (see git history instead)
*.bak
*.bak.*
*.save
# live runtime state — budget overrides written by /api/budget.
# tracked copies get clobbered by deploys; the server copy is authoritative.
budgets.json

# runtime account list added from the dashboard UI (server copy is authoritative)
accounts.json

# per-client dashboard logins written by the server (hashes; server copy is authoritative)
users.json
