<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ben ADU — Budget Pacing</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:#0a0a0a;color:#e8e8e8;min-height:100vh}
.wrap{max-width:1400px;margin:0 auto;padding:24px 24px}

/* Header */
.header{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:24px;flex-wrap:wrap;gap:12px}
.header h1{font-size:22px;font-weight:700;letter-spacing:-0.5px;color:#fff}
.header .sub{font-size:13px;color:#666;margin-top:4px}
.header-actions{display:flex;flex-direction:column;align-items:flex-end;gap:6px}
.btn{font-size:12px;padding:6px 14px;border-radius:8px;border:1px solid rgba(255,255,255,0.12);background:rgba(255,255,255,0.08);color:#e8e8e8;cursor:pointer;transition:all 0.15s}
.btn:hover{background:rgba(255,255,255,0.14)}
.btn:disabled{opacity:0.4;cursor:not-allowed}
.btn-sm{font-size:11px;padding:3px 8px;border-radius:6px}
.btn-save{background:#1baf7a;border-color:#1baf7a;color:#fff}
.btn-save:hover{background:#17a06e}
.meta-info{font-size:10px;color:#444}

/* Last-updated live indicator */
.live-badge{display:inline-flex;align-items:center;gap:8px;padding:5px 12px;border-radius:20px;background:#141414;border:1px solid rgba(255,255,255,0.08);font-size:12px;color:#aaa;cursor:default;transition:all 0.2s}
.live-badge:hover{border-color:rgba(255,255,255,0.16)}
.live-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;background:#1baf7a;box-shadow:0 0 0 0 rgba(27,175,122,0.6);animation:live-pulse 2.4s ease-in-out infinite}
.live-badge[data-state="stale"]{color:#f0c060}
.live-badge[data-state="stale"] .live-dot{background:#eda100;box-shadow:0 0 0 0 rgba(237,161,0,0.6);animation-duration:3s}
.live-badge[data-state="dead"]{color:#f08080}
.live-badge[data-state="dead"] .live-dot{background:#e34948;box-shadow:0 0 0 0 rgba(227,73,72,0.6);animation:none;opacity:0.9}
.live-badge[data-state="loading"] .live-dot{background:#6aadf0;box-shadow:0 0 0 0 rgba(106,173,240,0.6);animation-duration:1s}
.live-badge[data-state="loading"]{color:#6aadf0}
.live-time{color:inherit;font-variant-numeric:tabular-nums}
.live-label{font-weight:600;letter-spacing:0.2px}
@keyframes live-pulse{
  0%{box-shadow:0 0 0 0 rgba(27,175,122,0.55)}
  70%{box-shadow:0 0 0 8px rgba(27,175,122,0)}
  100%{box-shadow:0 0 0 0 rgba(27,175,122,0)}
}

/* Alerts */
.alert{padding:12px 16px;border-radius:10px;margin-bottom:12px;font-size:13px;display:flex;align-items:flex-start;gap:10px;line-height:1.4}
.alert-danger{background:rgba(227,73,72,0.08);border:1px solid rgba(227,73,72,0.2);color:#f08080}
.alert-warn{background:rgba(237,161,0,0.08);border:1px solid rgba(237,161,0,0.2);color:#f0c060}
.alert-info{background:rgba(42,120,214,0.08);border:1px solid rgba(42,120,214,0.2);color:#6aadf0}
.alert-icon{font-size:18px;flex-shrink:0;line-height:1}
.alert strong{font-weight:600}

/* Summary cards */
.summary{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px;margin-bottom:20px}
.stat{padding:14px 18px;border-radius:10px;background:#141414;border:1px solid rgba(255,255,255,0.06)}
.stat-label{font-size:12px;color:#666;margin-bottom:4px}
.stat-val{font-size:22px;font-weight:700}
.stat-val.over{color:#e34948}
.stat-val.under{color:#1baf7a}

/* Geo cards */
.geo-grid{display:grid;grid-template-columns:1fr;gap:14px}
.geo-card{background:#141414;border-radius:12px;padding:18px 20px;border:1px solid rgba(255,255,255,0.06);transition:border-color 0.2s;display:flex;flex-direction:column}
.geo-card.over-budget{border-color:rgba(227,73,72,0.3)}
.geo-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;flex-wrap:wrap;gap:8px}
.geo-name{display:flex;align-items:center;gap:10px;font-size:16px;font-weight:600}
.geo-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0}
.geo-actions{display:flex;align-items:center;gap:8px}

/* Status badge */
.badge{font-size:11px;font-weight:600;padding:3px 10px;border-radius:20px;letter-spacing:0.3px}
.badge-ok{background:#1baf7a;color:#fff}
.badge-warn{background:#eda100;color:#412402}
.badge-over{background:#e34948;color:#fff}

/* Progress bar */
.bar-wrap{height:6px;border-radius:3px;background:rgba(255,255,255,0.06);overflow:hidden;margin-bottom:4px}
.bar-fill{height:100%;border-radius:3px;transition:width 0.5s ease}
.bar-label{display:flex;justify-content:space-between;font-size:12px;color:#666;margin-bottom:6px}

/* Metric grid */
.metrics{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:10px;margin-top:14px}
.metric{padding:12px 14px;border-radius:8px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.06);cursor:help}
.metric-label{font-size:11px;color:#888;margin-bottom:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;display:flex;align-items:center;gap:4px}
.metric-label .info{display:inline-block;width:12px;height:12px;line-height:12px;text-align:center;font-size:9px;font-weight:700;color:#555;border:1px solid #333;border-radius:50%;flex-shrink:0}
.metric:hover .metric-label .info{color:#888;border-color:#555}
.metric-val{font-size:16px;font-weight:600}
.metric-sub{font-size:10px;color:#666;margin-top:2px}
.val-danger{color:#e34948}
.val-warn{color:#eda100}

/* Campaign breakdown */
.campaigns-toggle{font-size:12px;color:#666;cursor:pointer;user-select:none;margin-top:12px;padding:0;background:none;border:none;text-decoration:underline;text-underline-offset:2px}
.campaigns-toggle:hover{color:#888}
.campaigns-list{margin-top:8px;font-size:12px}
.camp-row{display:flex;justify-content:space-between;padding:5px 0;border-bottom:1px solid rgba(255,255,255,0.04);gap:8px}
.camp-row:last-child{border-bottom:none}
.camp-header{font-size:10px;color:#555;text-transform:uppercase;letter-spacing:0.5px;font-weight:600;padding:6px 0 4px;border-bottom:1px solid rgba(255,255,255,0.08)}
.camp-name{color:#aaa;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1;min-width:0}
.camp-stats{display:flex;gap:16px;flex-shrink:0}
.camp-stats span{min-width:60px;text-align:right}

/* Budget edit */
.budget-edit{display:flex;align-items:center;gap:4px}
.budget-edit input{width:90px;padding:4px 8px;font-size:12px;border-radius:6px;border:1px solid rgba(255,255,255,0.15);background:#1a1a1a;color:#e8e8e8;text-align:right;font-family:inherit}

/* Footer */
.footer{margin-top:24px;padding:14px 18px;border-radius:10px;background:#141414;border:1px solid rgba(255,255,255,0.06);font-size:12px;color:#555;line-height:1.6}
.footer strong{color:#888;font-weight:600}

/* Loading */
.loading-overlay{position:fixed;inset:0;background:rgba(10,10,10,0.9);display:flex;align-items:center;justify-content:center;z-index:100}
.spinner{width:32px;height:32px;border:3px solid rgba(255,255,255,0.1);border-top-color:#e8e8e8;border-radius:50%;animation:spin 0.8s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}

/* Password */
.auth-screen{position:fixed;inset:0;background:#0a0a0a;display:flex;align-items:center;justify-content:center;z-index:200}
.auth-box{text-align:center}
.auth-box h2{font-size:18px;font-weight:600;margin-bottom:16px}
.auth-box input{padding:8px 14px;border-radius:8px;border:1px solid rgba(255,255,255,0.15);background:#141414;color:#e8e8e8;font-size:14px;width:220px;margin-bottom:8px;display:block;text-align:center;font-family:inherit}
.auth-box .btn{width:220px}

/* Responsive */
@media(max-width:600px){
  .wrap{padding:20px 14px}
  .summary{grid-template-columns:repeat(2,1fr)}
  .metrics{grid-template-columns:repeat(2,1fr)}
  .camp-stats{gap:8px}
  .camp-stats span{min-width:50px;font-size:11px}
}

/* Desktop: 2-column geo grid so all 4 counties fit on screen */
@media(min-width:1100px){
  .wrap{padding:32px 32px}
  .header h1{font-size:26px}
  .summary{grid-template-columns:repeat(4,1fr)}
  .stat-val{font-size:24px}
  .geo-grid{grid-template-columns:repeat(2,1fr);gap:16px;align-items:start}
  .metrics{grid-template-columns:repeat(4,1fr)}
  .metric-val{font-size:17px}
  .geo-name{font-size:17px}
}

/* Extra-wide monitors: keep 2×2 but breathe more */
@media(min-width:1600px){
  .wrap{max-width:1500px;padding:36px 40px}
  .metrics{grid-template-columns:repeat(8,1fr)}
}
</style>
</head>
<body>

<div id="auth-screen" class="auth-screen" style="display:none">
  <div class="auth-box">
    <h2>Dashboard login</h2>
    <input type="password" id="auth-password" placeholder="Password" onkeydown="if(event.key==='Enter')doAuth()">
    <button class="btn" onclick="doAuth()" style="width:220px;margin-top:4px">Enter</button>
  </div>
</div>

<div id="loading" class="loading-overlay" style="display:none">
  <div style="text-align:center">
    <div class="spinner"></div>
    <div style="margin-top:12px;font-size:13px;color:#666">Pulling live data from Meta Ads...</div>
  </div>
</div>

<div class="wrap" id="dashboard" style="display:none">
  <div class="header">
    <div>
      <h1>Budget pacing</h1>
      <div class="sub" id="monthLabel"></div>
    </div>
    <div class="header-actions">
      <button class="btn" id="refreshBtn" onclick="doRefresh()">Refresh live data</button>
      <div class="live-badge" id="liveBadge" data-state="live" title="">
        <span class="live-dot"></span>
        <span class="live-label" id="liveLabel">Live</span>
        <span class="live-time" id="liveTime"></span>
      </div>
    </div>
  </div>

  <div id="alerts"></div>
  <div class="summary" id="summary"></div>
  <div class="geo-grid" id="geoCards"></div>

  <div class="footer">
    <strong>How this dashboard works</strong><br>
    Live spend numbers are pulled directly from Meta Ads every <span id="refreshInterval"></span> minutes — no manual updates needed.
    Each ad campaign is automatically sorted into the right county based on its name.
    To change a county's monthly budget, click <em>Edit budget</em> — the new number is saved permanently and used for all future calculations.
    Hover any metric (the small <strong>?</strong> icon) to see exactly what it means.
  </div>
</div>

<script>
const API_BASE = '';
let dashData = null;
let openCampaigns = {};
let editingBudget = {};

async function doAuth() {
  const pw = document.getElementById('auth-password').value;
  try {
    const res = await fetch(`${API_BASE}/api/auth`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ password: pw })
    });
    if (res.ok) {
      document.getElementById('auth-screen').style.display = 'none';
      localStorage.setItem('dash_pw', pw);
      init();
    } else {
      alert('Wrong password');
    }
  } catch (e) {
    alert('Connection error');
  }
}

function getAuthHeader() {
  const pw = localStorage.getItem('dash_pw');
  return pw ? { 'Authorization': `Bearer ${pw}` } : {};
}

async function fetchDashboard() {
  const res = await fetch(`${API_BASE}/api/dashboard`, { headers: getAuthHeader() });
  if (res.status === 401) {
    document.getElementById('auth-screen').style.display = 'flex';
    document.getElementById('dashboard').style.display = 'none';
    return null;
  }
  return res.json();
}

async function doRefresh() {
  const btn = document.getElementById('refreshBtn');
  btn.disabled = true;
  btn.textContent = 'Pulling data...';
  setLiveState('loading', 'Fetching…');
  try {
    await fetch(`${API_BASE}/api/refresh`, { method: 'POST', headers: getAuthHeader() });
    await loadData();
  } catch (e) {
    console.error(e);
    setLiveState('dead', 'Failed');
  }
  btn.disabled = false;
  btn.textContent = 'Refresh live data';
}

function relativeTime(ts) {
  const now = Date.now();
  const diff = Math.max(0, now - ts);
  const sec = Math.floor(diff / 1000);
  if (sec < 10) return 'just now';
  if (sec < 60) return `${sec}s ago`;
  const min = Math.floor(sec / 60);
  if (min === 1) return '1 minute ago';
  if (min < 60) return `${min} minutes ago`;
  const hr = Math.floor(min / 60);
  if (hr === 1) return '1 hour ago';
  if (hr < 24) return `${hr} hours ago`;
  const day = Math.floor(hr / 24);
  return day === 1 ? '1 day ago' : `${day} days ago`;
}

function setLiveState(state, labelText) {
  const b = document.getElementById('liveBadge');
  const l = document.getElementById('liveLabel');
  const t = document.getElementById('liveTime');
  if (!b) return;
  b.dataset.state = state;
  if (labelText !== undefined) l.textContent = labelText;
  if (state === 'loading') t.textContent = '';
}

function updateLiveBadge() {
  if (!dashData || !dashData.meta) return;
  const b = document.getElementById('liveBadge');
  if (!b || b.dataset.state === 'loading') return;

  const lf = dashData.meta.lastFetched;
  if (dashData.meta.error) {
    b.dataset.state = 'dead';
    document.getElementById('liveLabel').textContent = 'Fetch error';
    document.getElementById('liveTime').textContent = lf ? `· last ok ${relativeTime(new Date(lf).getTime())}` : '';
    b.title = dashData.meta.error;
    return;
  }
  if (!lf) {
    b.dataset.state = 'dead';
    document.getElementById('liveLabel').textContent = 'No data yet';
    document.getElementById('liveTime').textContent = '';
    return;
  }
  const ts = new Date(lf).getTime();
  const ageMin = (Date.now() - ts) / 60000;
  const refreshMin = dashData.meta.refreshIntervalMinutes || 60;

  let state = 'live', label = 'Live';
  if (ageMin > refreshMin * 3) { state = 'dead'; label = 'Stale'; }
  else if (ageMin > refreshMin * 1.25) { state = 'stale'; label = 'Delayed'; }

  b.dataset.state = state;
  document.getElementById('liveLabel').textContent = label;
  document.getElementById('liveTime').textContent = `· updated ${relativeTime(ts)}`;
  b.title = `Last successful fetch: ${new Date(lf).toLocaleString()}\nAuto-refresh: every ${refreshMin} min`;
}

function fmt(n) { return '$' + Math.round(n).toLocaleString(); }
function fmtDec(n) { return '$' + n.toFixed(2); }

function statusBadge(status) {
  const map = {
    on_track: { cls: 'badge-ok', label: 'On track' },
    at_risk: { cls: 'badge-warn', label: 'At risk' },
    over_budget: { cls: 'badge-over', label: 'Over budget' }
  };
  const s = map[status] || map.on_track;
  return `<span class="badge ${s.cls}">${s.label}</span>`;
}

function barColor(status) {
  return status === 'over_budget' ? '#e34948' : status === 'at_risk' ? '#eda100' : '#1baf7a';
}

function renderAlerts(geos) {
  let html = '';
  geos.forEach(g => {
    if (g.status === 'over_budget') {
      const over = g.spent - g.budget;
      html += `<div class="alert alert-danger">
        <span class="alert-icon">⚠</span>
        <div><strong>${g.name}</strong> is ${fmt(over)} over the ${fmt(g.budget)} budget (${Math.round(g.pctSpent)}% spent) — pause or reduce immediately</div>
      </div>`;
    } else if (g.status === 'at_risk') {
      html += `<div class="alert alert-warn">
        <span class="alert-icon">⚡</span>
        <div><strong>${g.name}</strong> is at ${Math.round(g.pctSpent)}% of budget — approaching limit</div>
      </div>`;
    }
  });
  return html;
}

function renderSummary(summary) {
  const overCls = summary.totalOver > 0 ? 'over' : 'under';
  const overUnderLabel = summary.totalOver > 0 ? 'Over budget by' : 'Under budget by';
  return `
    <div class="stat" title="Total budget across all 4 counties this month"><div class="stat-label">Monthly budget</div><div class="stat-val">${fmt(summary.totalBudget)}</div></div>
    <div class="stat" title="Total spent so far this month across all counties"><div class="stat-label">Spent so far</div><div class="stat-val ${summary.totalSpent > summary.totalBudget ? 'over' : ''}">${fmt(summary.totalSpent)}</div></div>
    <div class="stat" title="Difference between total spent and total budget"><div class="stat-label">${overUnderLabel}</div><div class="stat-val ${overCls}">${fmt(Math.abs(summary.totalOver))}</div></div>
    <div class="stat" title="Total leads generated this month across all counties"><div class="stat-label">Leads this month</div><div class="stat-val">${summary.totalLeads.toLocaleString()}</div></div>
  `;
}

function renderGeoCard(g) {
  const isEditing = editingBudget[g.id];
  const showCampaigns = openCampaigns[g.id];
  // Use last-7-day pace when available (matches Slack); fall back to MTD average early in the month
  const dailyAvg = g.weekDaily != null ? g.weekDaily : g.actualDaily;
  const paceRatio = g.dailyTarget > 0 ? dailyAvg / g.dailyTarget : 0;

  let campaignsHtml = '';
  if (showCampaigns && g.campaigns.length > 0) {
    campaignsHtml = '<div class="campaigns-list">' +
      `<div class="camp-row camp-header">
        <span class="camp-name">Campaign name</span>
        <div class="camp-stats">
          <span>Spent</span>
          <span>Leads</span>
          <span>Cost/lead</span>
        </div>
      </div>` +
      g.campaigns.map(c => `
        <div class="camp-row">
          <span class="camp-name" title="${c.name}">${c.name}</span>
          <div class="camp-stats">
            <span style="color:#e8e8e8">${fmt(c.spend)}</span>
            <span style="color:#888">${c.leads}</span>
            <span style="color:#666">${c.leads > 0 ? fmtDec(c.spend / c.leads) : '—'}</span>
          </div>
        </div>
      `).join('') + '</div>';
  }

  return `
    <div class="geo-card ${g.status === 'over_budget' ? 'over-budget' : ''}">
      <div class="geo-head">
        <div class="geo-name">
          <span class="geo-dot" style="background:${g.color}"></span>
          ${g.name}
        </div>
        <div class="geo-actions">
          ${statusBadge(g.status)}
          ${isEditing ? `
            <div class="budget-edit">
              <input type="number" id="budget-input-${g.id}" value="${g.budget}" step="1000">
              <button class="btn btn-sm btn-save" onclick="saveBudget('${g.id}')">Save</button>
              <button class="btn btn-sm" onclick="cancelEdit('${g.id}')">×</button>
            </div>
          ` : `
            <button class="btn btn-sm" onclick="startEdit('${g.id}')">Edit budget</button>
          `}
        </div>
      </div>

      <div class="bar-label">
        <span>${fmt(g.spent)} of ${fmt(g.budget)}</span>
        <span>${Math.round(g.pctSpent)}%</span>
      </div>
      <div class="bar-wrap">
        <div class="bar-fill" style="width:${Math.min(100, g.pctSpent)}%;background:${barColor(g.status)}"></div>
      </div>

      <div class="metrics">
        <div class="metric" title="How much of this county's monthly budget is still available to spend">
          <div class="metric-label">Budget left <span class="info">?</span></div>
          <div class="metric-val ${g.remaining === 0 ? 'val-danger' : ''}">${g.remaining > 0 ? fmt(g.remaining) : '$0'}</div>
        </div>
        <div class="metric" title="Days remaining in the current calendar month">
          <div class="metric-label">Days left in month <span class="info">?</span></div>
          <div class="metric-val">${g.daysLeft}</div>
        </div>
        <div class="metric" title="Ideal daily spend to hit budget exactly by month-end (monthly budget ÷ days in month)">
          <div class="metric-label">Ideal daily spend <span class="info">?</span></div>
          <div class="metric-val">${fmt(g.dailyTarget)}</div>
        </div>
        <div class="metric" title="Average daily spend over the last 7 days — the forward-looking pace used to project month-end totals">
          <div class="metric-label">Your daily avg <span class="info">?</span></div>
          <div class="metric-val ${paceRatio > 1.15 ? 'val-warn' : ''}">${fmt(dailyAvg)}</div>
          ${paceRatio > 1 ? `<div class="metric-sub">${Math.round((paceRatio - 1) * 100)}% above ideal · last 7 days</div>` : paceRatio > 0 && paceRatio < 0.85 ? `<div class="metric-sub">${Math.round((1 - paceRatio) * 100)}% below ideal · last 7 days</div>` : `<div class="metric-sub">last 7 days</div>`}
        </div>
        <div class="metric" title="Suggested daily spend for the rest of the month to land exactly on budget (budget left ÷ days left)">
          <div class="metric-label">Suggested daily now <span class="info">?</span></div>
          <div class="metric-val ${g.remaining <= 0 ? 'val-danger' : ''}">${g.remaining > 0 ? fmt(g.recDaily) : 'Pause'}</div>
        </div>
        <div class="metric" title="Estimated total spend by the end of the month if the last 7 days' pace continues. This matches the Slack weekly summary.">
          <div class="metric-label">On track to spend <span class="info">?</span></div>
          <div class="metric-val ${g.projectedEOM > g.budget * 1.15 ? 'val-danger' : g.projectedEOM > g.budget * 1.05 ? 'val-warn' : ''}">${fmt(g.projectedEOM)}</div>
          <div class="metric-sub">by month-end · last 7d pace</div>
        </div>
        <div class="metric" title="Total leads generated this month for this county">
          <div class="metric-label">Leads this month <span class="info">?</span></div>
          <div class="metric-val">${g.leads.toLocaleString()}</div>
        </div>
        <div class="metric" title="Cost Per Lead — average ad spend to generate one lead (spent ÷ leads)">
          <div class="metric-label">Cost per lead <span class="info">?</span></div>
          <div class="metric-val">${g.cpl > 0 ? fmtDec(g.cpl) : '—'}</div>
        </div>
      </div>

      ${g.campaigns.length > 0 ? `
        <button class="campaigns-toggle" onclick="toggleCampaigns('${g.id}')">
          ${showCampaigns ? 'Hide' : 'Show'} campaign breakdown (${g.campaigns.length})
        </button>
        ${campaignsHtml}
      ` : ''}
    </div>
  `;
}

function startEdit(geoId) {
  editingBudget[geoId] = true;
  render();
}

function cancelEdit(geoId) {
  delete editingBudget[geoId];
  render();
}

async function saveBudget(geoId) {
  const input = document.getElementById(`budget-input-${geoId}`);
  const newBudget = parseFloat(input.value);
  if (isNaN(newBudget) || newBudget <= 0) return;

  try {
    await fetch(`${API_BASE}/api/budget`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', ...getAuthHeader() },
      body: JSON.stringify({ geoId, budget: newBudget })
    });
    delete editingBudget[geoId];
    await loadData();
  } catch (e) {
    alert('Failed to save budget');
  }
}

function toggleCampaigns(geoId) {
  openCampaigns[geoId] = !openCampaigns[geoId];
  render();
}

function render() {
  if (!dashData) return;

  document.getElementById('monthLabel').textContent = `Ben ADU — ${dashData.meta.month}`;
  document.getElementById('alerts').innerHTML = renderAlerts(dashData.geos);
  document.getElementById('summary').innerHTML = renderSummary(dashData.summary);
  document.getElementById('geoCards').innerHTML = dashData.geos.map(renderGeoCard).join('');
  document.getElementById('refreshInterval').textContent = dashData.meta.refreshIntervalMinutes;

  updateLiveBadge();

  if (dashData.meta.error) {
    const alertsEl = document.getElementById('alerts');
    alertsEl.innerHTML = `<div class="alert alert-info">
      <span class="alert-icon">ℹ</span>
      <div>${dashData.meta.error}</div>
    </div>` + alertsEl.innerHTML;
  }
}

async function loadData() {
  dashData = await fetchDashboard();
  if (dashData) render();
}

async function init() {
  document.getElementById('loading').style.display = 'flex';
  document.getElementById('dashboard').style.display = 'none';

  dashData = await fetchDashboard();

  document.getElementById('loading').style.display = 'none';

  if (dashData) {
    document.getElementById('dashboard').style.display = 'block';
    render();
  }

  // Auto-refresh dashboard data every 5 minutes on the frontend
  setInterval(loadData, 5 * 60 * 1000);
  // Tick the "X minutes ago" indicator every 30 seconds so it stays honest between refreshes
  setInterval(updateLiveBadge, 30 * 1000);
}

// Start
init();
</script>
</body>
</html>
